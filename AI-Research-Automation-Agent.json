    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet document = \"\";\n\nitems.forEach((item, index) => {\n\ndocument += `\n\n========================\nARTICLE ${index + 1}\n========================\n\nTITLE:\n${item.json.title}\n\nSOURCE:\n${item.json.url}\n\nCONTENT:\n${item.json.cleanText}\n\n`;\n\n});\n\nreturn [{\njson:{\nresearchDocument: document\n}\n}];"
      },
