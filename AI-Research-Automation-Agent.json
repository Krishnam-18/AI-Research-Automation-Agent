        -16
      ],
      "id": "322da003-015c-4acb-941b-6ba2e110ba27",
      "name": "AI Success?"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $json.text || \"\";\n\n// 1. Extract only the content after the last \"# Executive Summary\" (if present)\nlet cleanedText = rawText;\nif (rawText.includes(\"# Executive Summary\")) {\n  const parts = rawText.split(\"# Executive Summary\");\n  cleanedText = \"# Executive Summary\" + parts[parts.length - 1];\n}\n\ncleanedText = cleanedText\n  // Convert Markdown headers (# Header) into bold titles with a line break\n  .replace(/^#+\\s*(.*)$/gm, '**$1**\\n')\n  \n  // Standardize bullet points (* or -) to clean bullet symbols\n  .replace(/^[\\s]*[\\*\\-]\\s+/gm, '• ')\n\n  // Ensure double line breaks between paragraphs and sections\n  .replace(/\\n{2,}/g, '\\n\\n');\n\nreturn [{\n  json: {\n    report: cleanedText.trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -32
      ],
      "id": "cf481329-f6e6-4f2e-9d18-741a7308b73c",
      "name": "Extract AI Response"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst unique = [];\n\nfor (const item of $input.all()) {\n  const url = (item.json.url || '').toLowerCase().trim();\n  const title = (item.json.title || '').toLowerCase().trim();\n  \n  const key = `${url}|${title}`;\n\n  if (!seen.has(key)) {\n    seen.add(key);\n    unique.push(item);\n  }\n}\n\nreturn unique;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        -16
      ],
      "id": "27224055-2c9c-45bf-a13d-98849f4e07f2",
      "name": "Remove Duplicate Articles"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let raw = String(item.json.raw_content || item.json.content || \"\");\n\n  // 1. Remove Markdown images explicitly (e.g., ![alt](url))\n  raw = raw.replace(/!\\[.*?\\]\\(.*?\\)/g, \"\");\n\n  // 2. Extract link text, strip URL (e.g., [text](url) -> text)\n  raw = raw.replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, \"$1\");\n\n  // 3. Remove common boilerplate\n  raw = raw.replace(\n    /(Advertisement|Subscribe|Cookie Policy|Privacy Policy|Terms of Service|Continue browsing|Take the next step|Need help getting started|Work with a trusted partner|Facebook|Twitter|LinkedIn|Instagram|Sign In|Register)/gi,\n    \"\"\n  );\n\n  // 4. Collapse consecutive spaces/tabs per line (preserves line breaks)\n  raw = raw.replace(/[^\\S\\r\\n]+/g, \" \");\n\n  // 5. Clean up multiple empty lines and trim spaces around lines\n  raw = raw.replace(/\\n\\s*\\n+/g, \"\\n\").trim();\n\n  return {\n    json: {\n      ...item.json,\n      cleanText: raw\n    }\n  };\n});"
      },
